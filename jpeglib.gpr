library project Jpeglib is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/jpeglib";
   for Library_Dir use "lib";
   for Library_Name use "jpeglib";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata", "-gnato", "-gnatVa", "-gnatwa");
   end Compiler;
end Jpeglib;
