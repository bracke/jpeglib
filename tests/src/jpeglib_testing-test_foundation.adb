            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert (Blocks_Decoded = 255, Label & " coefficient count mismatch");
         for Block of Blocks loop
            Assert (Block (0) = 128, Label & " coefficient sample mismatch");
