            Destination'Access,
            (Mode => Jpeglib.Encoding.Arithmetic_Sequential_DCT,
             Progressive => Script,
             Quality => 100,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " arithmetic progressive CMYK DC encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            Label & " arithmetic progressive CMYK DC encoder state mismatch");

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " arithmetic progressive CMYK DC decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            Label & " arithmetic progressive CMYK DC decoder state mismatch");

         Info := Jpeglib.Decoding.Header (Decoder);
         Assert (Info.Entropy = Jpeglib.Arithmetic, Label & " arithmetic progressive CMYK DC entropy mismatch");
         Assert (Info.Progressive, Label & " arithmetic progressive CMYK DC header not marked progressive");
         Assert (Info.Mode = Jpeglib.Progressive_DCT, Label & " arithmetic progressive CMYK DC mode mismatch");
         Assert
           (Info.Color_Model = Expected_Color_Model,
            Label & " arithmetic progressive four-component DC color model mismatch");
         Assert (Info.Coefficient_Blocks = 4, Label & " arithmetic progressive CMYK DC coefficient count mismatch");
         for Index in Decoded_Storage'Range loop
            Assert
              (Decoded_Storage (Index) = Input_Storage (Index),
               Label & " arithmetic progressive CMYK DC sample mismatch at"
               & Positive'Image (Index)
               & ": expected"
               & Jpeglib.Byte'Image (Input_Storage (Index))
               & " got"
               & Jpeglib.Byte'Image (Decoded_Storage (Index)));
         end loop;
      end Roundtrips_Four_Component_DC;

      procedure Roundtrips_Four_Component_AC
        (Script : Jpeglib.Encoding.Progressive_Script;
         Format : Jpeglib.Images.Pixel_Format;
         Expected_Color_Model : Jpeglib.Encoded_Color_Model;
         Channel : Natural;
         Label : String)
      is
         Input_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 4 => 128];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 4 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => 8,
               Height => 8,
               Format => Format,
               Stride => Jpeglib.Row_Stride (8 * 4),
               Accessible_Bytes => 8 * 8 * 4),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 8,
               Height => 8,
               Format => Format,
               Stride => Jpeglib.Row_Stride (8 * 4),
               Accessible_Bytes => 8 * 8 * 4),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Info : Jpeglib.Decoding.Image_Info;
      begin
         for Index in Jpeglib.Coefficient_Index range 0 .. 63 loop
            Input_Storage (Input_Storage'First + Natural (Index) * 4 + Channel) := Expected_AC_Block (Index);
         end loop;

         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Jpeglib.Encoding.Arithmetic_Sequential_DCT,
             Progressive => Script,
             Quality => 100,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " arithmetic progressive CMYK AC encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            Label & " arithmetic progressive CMYK AC encoder state mismatch");

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " arithmetic progressive CMYK AC decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            Label & " arithmetic progressive CMYK AC decoder state mismatch");

         Info := Jpeglib.Decoding.Header (Decoder);
         Assert (Info.Entropy = Jpeglib.Arithmetic, Label & " arithmetic progressive CMYK AC entropy mismatch");
         Assert (Info.Progressive, Label & " arithmetic progressive CMYK AC header not marked progressive");
         Assert (Info.Mode = Jpeglib.Progressive_DCT, Label & " arithmetic progressive CMYK AC mode mismatch");
         Assert
           (Info.Color_Model = Expected_Color_Model,
            Label & " arithmetic progressive four-component AC color model mismatch");
         Assert (Info.Coefficient_Blocks = 4, Label & " arithmetic progressive CMYK AC coefficient count mismatch");
         Assert (Decoded_Storage = Input_Storage, Label & " arithmetic progressive CMYK AC samples mismatch");
      end Roundtrips_Four_Component_AC;

      procedure Roundtrips_Detailed_2x2
        (Script : Jpeglib.Encoding.Progressive_Script;
         Label : String)
      is
         Input_Storage : aliased Jpeglib.Streams.Byte_Array :=
           [0, 32, 64,
            96, 128, 160,
            192, 224, 240,
            255, 16, 48];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 12 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 2,
               Format => Jpeglib.Images.RGB_24,
               Stride => 6,
               Accessible_Bytes => 12),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 2,
               Format => Jpeglib.Images.RGB_24,
               Stride => 6,
               Accessible_Bytes => 12),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
      begin
         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Jpeglib.Encoding.Arithmetic_Sequential_DCT,
             Progressive => Script,
             Subsampling => Jpeglib.Encoding.Subsampling_444,
             Quality => 100,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " detailed 2x2 arithmetic progressive RGB encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            Label & " detailed 2x2 arithmetic progressive RGB encoder state mismatch");

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Jpeglib.Images.RGB_24, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " detailed 2x2 arithmetic progressive RGB decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code)
            & " source="
            & Jpeglib.Source_Offset'Image (Outcome.First_Error.Context.Source)
            & " marker="
            & Jpeglib.Marker_Code'Image (Outcome.First_Error.Context.Marker)
            & " detail="
            & Long_Long_Integer'Image (Outcome.First_Error.Context.Detail));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            Label & " detailed 2x2 arithmetic progressive RGB decoder state mismatch");
      end Roundtrips_Detailed_2x2;

      procedure Roundtrips_Four_Component_Detailed_2x2
        (Script : Jpeglib.Encoding.Progressive_Script;
         Format : Jpeglib.Images.Pixel_Format;
         Expected_Color_Model : Jpeglib.Encoded_Color_Model;
         Label : String)
      is
         Input_Storage : aliased Jpeglib.Streams.Byte_Array :=
           [0, 32, 64, 96,
            128, 160, 192, 224,
            240, 255, 16, 48,
            80, 112, 144, 176];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 16 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 2,
               Format => Format,
               Stride => 8,
               Accessible_Bytes => 16),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 2,
               Format => Format,
               Stride => 8,
               Accessible_Bytes => 16),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Info : Jpeglib.Decoding.Image_Info;

         function Count_SOS_Markers (Last : Jpeglib.Destination_Offset) return Natural is
            Count : Natural := 0;
            Limit : constant Positive := Positive (Last);
         begin
            for Index in Encoded_Storage'First .. Limit - 1 loop
               if Encoded_Storage (Index) = 16#FF#
                 and then Encoded_Storage (Index + 1) = Jpeglib.Byte (Jpeglib.Internal.Markers.SOS)
               then
                  Count := Count + 1;
               end if;
            end loop;

            return Count;
         end Count_SOS_Markers;
      begin
         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Jpeglib.Encoding.Arithmetic_Sequential_DCT,
             Progressive => Script,
             Quality => 100,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " detailed 2x2 arithmetic progressive four-component encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            Label & " detailed 2x2 arithmetic progressive four-component encoder state mismatch");
         Assert
           (Count_SOS_Markers (Jpeglib.Streams.Offset (Destination))
            = (if Script = Jpeglib.Encoding.Balanced_Progressive then 24 else 8),
            Label & " detailed 2x2 arithmetic progressive four-component scan count mismatch");

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " detailed 2x2 arithmetic progressive four-component decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code)
            & " source="
            & Jpeglib.Source_Offset'Image (Outcome.First_Error.Context.Source)
            & " marker="
            & Jpeglib.Marker_Code'Image (Outcome.First_Error.Context.Marker)
            & " detail="
            & Long_Long_Integer'Image (Outcome.First_Error.Context.Detail));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            Label & " detailed 2x2 arithmetic progressive four-component decoder state mismatch");

         Info := Jpeglib.Decoding.Header (Decoder);
         Assert (Info.Entropy = Jpeglib.Arithmetic, Label & " detailed four-component entropy mismatch");
         Assert (Info.Progressive, Label & " detailed four-component header not marked progressive");
         Assert (Info.Mode = Jpeglib.Progressive_DCT, Label & " detailed four-component mode mismatch");
         Assert
           (Info.Color_Model = Expected_Color_Model,
            Label & " detailed four-component color model mismatch");
         Assert (Info.Coefficient_Blocks = 4, Label & " detailed four-component coefficient count mismatch");
      end Roundtrips_Four_Component_Detailed_2x2;
   begin
      Roundtrips
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         0,
         Jpeglib.Encoding.Subsampling_444,
         12,
         "fast-preview 4:4:4 non-restarted");
      Roundtrips
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         2,
         Jpeglib.Encoding.Subsampling_444,
         12,
         "fast-preview 4:4:4 restarted");
      Roundtrips
        (Jpeglib.Encoding.Balanced_Progressive,
         0,
         Jpeglib.Encoding.Subsampling_444,
         12,
         "balanced 4:4:4 non-restarted");
      Roundtrips
        (Jpeglib.Encoding.Balanced_Progressive,
         2,
         Jpeglib.Encoding.Subsampling_444,
         12,
         "balanced 4:4:4 restarted");
      Roundtrips
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         0,
         Jpeglib.Encoding.Subsampling_422,
         8,
         "fast-preview 4:2:2");
      Roundtrips
        (Jpeglib.Encoding.Balanced_Progressive,
         2,
         Jpeglib.Encoding.Subsampling_422,
         8,
         "balanced 4:2:2 restarted");
      Roundtrips
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         0,
         Jpeglib.Encoding.Subsampling_420,
         6,
         "fast-preview 4:2:0");
      Roundtrips
        (Jpeglib.Encoding.Balanced_Progressive,
         2,
         Jpeglib.Encoding.Subsampling_420,
         6,
         "balanced 4:2:0 restarted");
      Roundtrips
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         0,
         Jpeglib.Encoding.Subsampling_411,
         12,
         "fast-preview 4:1:1");
      Roundtrips
        (Jpeglib.Encoding.Balanced_Progressive,
         2,
         Jpeglib.Encoding.Subsampling_411,
         12,
         "balanced 4:1:1 restarted");
      Roundtrips_AC (Jpeglib.Encoding.Fast_Preview_Progressive, "Y", "fast-preview");
      Roundtrips_AC (Jpeglib.Encoding.Balanced_Progressive, "Y", "balanced");
      Roundtrips_AC (Jpeglib.Encoding.Fast_Preview_Progressive, "Cb", "fast-preview");
      Roundtrips_AC (Jpeglib.Encoding.Balanced_Progressive, "Cb", "balanced");
      Roundtrips_AC (Jpeglib.Encoding.Fast_Preview_Progressive, "Cr", "fast-preview");
      Roundtrips_AC (Jpeglib.Encoding.Balanced_Progressive, "Cr", "balanced");
      Roundtrips_Detailed_2x2 (Jpeglib.Encoding.Fast_Preview_Progressive, "fast-preview");
      Roundtrips_Detailed_2x2 (Jpeglib.Encoding.Balanced_Progressive, "balanced");
      Roundtrips_Four_Component_Detailed_2x2
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         Jpeglib.Images.CMYK_32,
         Jpeglib.CMYK,
         "fast-preview CMYK");
      Roundtrips_Four_Component_Detailed_2x2
        (Jpeglib.Encoding.Balanced_Progressive,
         Jpeglib.Images.CMYK_32,
         Jpeglib.CMYK,
         "balanced CMYK");
      Roundtrips_Four_Component_Detailed_2x2
        (Jpeglib.Encoding.Fast_Preview_Progressive,
         Jpeglib.Images.YCCK_32,
         Jpeglib.YCCK,
         "fast-preview YCCK");
      Roundtrips_Four_Component_Detailed_2x2
        (Jpeglib.Encoding.Balanced_Progressive,
         Jpeglib.Images.YCCK_32,
         Jpeglib.YCCK,
         "balanced YCCK");
      Roundtrips_Four_Component_DC
        (Jpeglib.Encoding.Fast_Preview_Progressive, Jpeglib.Images.CMYK_32, Jpeglib.CMYK, "fast-preview CMYK");
      Roundtrips_Four_Component_DC
        (Jpeglib.Encoding.Balanced_Progressive, Jpeglib.Images.CMYK_32, Jpeglib.CMYK, "balanced CMYK");
      Roundtrips_Four_Component_DC
        (Jpeglib.Encoding.Fast_Preview_Progressive, Jpeglib.Images.YCCK_32, Jpeglib.YCCK, "fast-preview YCCK");
      Roundtrips_Four_Component_DC
        (Jpeglib.Encoding.Balanced_Progressive, Jpeglib.Images.YCCK_32, Jpeglib.YCCK, "balanced YCCK");
      for Channel in Natural range 0 .. 3 loop
         Roundtrips_Four_Component_AC
           (Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.CMYK_32,
            Jpeglib.CMYK,
            Channel,
            "fast-preview CMYK");
         Roundtrips_Four_Component_AC
           (Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.CMYK_32,
            Jpeglib.CMYK,
            Channel,
            "balanced CMYK");
         Roundtrips_Four_Component_AC
           (Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.YCCK_32,
            Jpeglib.YCCK,
            Channel,
            "fast-preview YCCK");
         Roundtrips_Four_Component_AC
           (Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.YCCK_32,
            Jpeglib.YCCK,
            Channel,
            "balanced YCCK");
      end loop;
   end Public_Encoder_Encodes_Arithmetic_Progressive_RGB_Image;

   procedure Public_Encoder_Encodes_Differential_DCT_Images
     (T : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T);
      use type Jpeglib.Decoding.Decoder_State;
      use type Jpeglib.Encoding.Encoding_Mode;
      use type Jpeglib.Encoding.Progressive_Script;
      Expected_AC_Block : constant Jpeglib.Internal.Transforms.Sample_Block :=
        Jpeglib.Internal.Transforms.Reconstruct_Block ([0 => 0, 1 => 1, others => 0]);

      function Expected_Color_Model
        (Format : Jpeglib.Images.Pixel_Format) return Jpeglib.Encoded_Color_Model
      is
        (case Format is
           when Jpeglib.Images.Gray_8 =>
             Jpeglib.Grayscale,
           when Jpeglib.Images.Gray_Alpha_16 =>
             Jpeglib.Unknown,
           when Jpeglib.Images.CMYK_32 =>
             Jpeglib.CMYK,
           when Jpeglib.Images.YCCK_32 =>
             Jpeglib.YCCK,
           when others =>
             Jpeglib.YCbCr);

      procedure Roundtrips
        (Mode : Jpeglib.Encoding.Encoding_Mode;
         Progressive : Jpeglib.Encoding.Progressive_Script;
         Format : Jpeglib.Images.Pixel_Format;
         Label : String;
         Restart : Jpeglib.Restart_Interval := 0;
         Width : Jpeglib.Image_Width := 8;
         Subsampling : Jpeglib.Encoding.Chroma_Subsampling := Jpeglib.Encoding.Subsampling_444;
         Pattern_Channel : Natural := 4)
      is
         Bytes_Per_Pixel : constant Natural := Natural (Jpeglib.Images.Bytes_Per_Pixel (Format));
         Storage_Length : constant Positive := Positive (Natural (Width) * 8 * Bytes_Per_Pixel);
         Input_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. Storage_Length => 128];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. Storage_Length => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => Width,
               Height => 8,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Natural (Width) * Bytes_Per_Pixel),
               Accessible_Bytes => Jpeglib.Byte_Count (Storage_Length)),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => Width,
               Height => 8,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Natural (Width) * Bytes_Per_Pixel),
               Accessible_Bytes => Jpeglib.Byte_Count (Storage_Length)),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Header : Jpeglib.Decoding.Image_Info;
         Expected_Entropy : constant Jpeglib.Entropy_Mode :=
           (if Mode = Jpeglib.Encoding.Arithmetic_Differential_Sequential_DCT
            then Jpeglib.Arithmetic
            else Jpeglib.Huffman);
         Expected_Mode : constant Jpeglib.Frame_Mode :=
           (if Progressive = Jpeglib.Encoding.No_Progressive
            then Jpeglib.Differential_Sequential_DCT
            else Jpeglib.Differential_Progressive_DCT);
         Expected_Color : constant Jpeglib.Encoded_Color_Model :=
           Expected_Color_Model (Format);
      begin
         if Pattern_Channel < Bytes_Per_Pixel then
            for Index in Jpeglib.Coefficient_Index range 0 .. 63 loop
               Input_Storage
                 (Input_Storage'First
                  + Natural (Index) * Bytes_Per_Pixel
                  + Pattern_Channel) :=
                    Expected_AC_Block (Index);
            end loop;
         end if;

         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Mode,
             Progressive => Progressive,
             Quality => 100,
             Restart => Restart,
             Subsampling => Subsampling,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " differential DCT encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            Label & " differential DCT encoder state mismatch");

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " differential DCT decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            Label & " differential DCT decoder state mismatch");

         Header := Jpeglib.Decoding.Header (Decoder);
         Assert (Header.Mode = Expected_Mode, Label & " differential DCT mode mismatch");
         Assert (Header.Progressive = (Progressive /= Jpeglib.Encoding.No_Progressive),
                 Label & " differential DCT progressive flag mismatch");
         Assert (Header.Entropy = Expected_Entropy, Label & " differential DCT entropy mismatch");
         Assert (Header.Color_Model = Expected_Color, Label & " differential DCT color model mismatch");
         Assert (Header.Restart = Restart, Label & " differential DCT restart mismatch");
         Assert (Decoded_Storage = Input_Storage, Label & " differential DCT pixel mismatch");
      end Roundtrips;
   begin
      for Mode in Jpeglib.Encoding.Differential_Sequential_DCT ..
        Jpeglib.Encoding.Arithmetic_Differential_Sequential_DCT
      loop
         Roundtrips (Mode, Jpeglib.Encoding.No_Progressive, Jpeglib.Images.Gray_8, "grayscale sequential");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.Gray_Alpha_16,
            "gray-alpha sequential");
         Roundtrips (Mode, Jpeglib.Encoding.No_Progressive, Jpeglib.Images.RGB_24, "RGB sequential");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB sequential 4:2:2",
            Subsampling => Jpeglib.Encoding.Subsampling_422,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB sequential 4:2:0",
            Subsampling => Jpeglib.Encoding.Subsampling_420,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
