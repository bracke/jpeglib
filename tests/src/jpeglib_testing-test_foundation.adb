            Jpeglib.Streams.Open (Destination, Storage'Unchecked_Access);
            Require
              (Jpeglib.Internal.Writers.Write_Marker (Destination, Jpeglib.Internal.Markers.SOI),
               "unknown arithmetic differential-lossless SOI");
            Require
              (Jpeglib.Internal.Writers.Write_DAC
                 (Destination,
                  Jpeglib.Internal.Arithmetic.DC,
                  Index => 0,
                  Conditioning => 16#5A#),
               "unknown arithmetic differential-lossless DAC");
            if Components = 2 then
               Require
                 (Jpeglib.Internal.Writers.Write_Segment
                    (Destination,
                     Jpeglib.Internal.Markers.SOF15,
                     [8, 0, 1, 0, 1, 2,
                      16#41#, 16#11#, 0,
                      16#42#, 16#11#, 0]),
                  "unknown arithmetic differential-lossless SOF15 two-component");
               Require
                 (Jpeglib.Internal.Writers.Write_Segment
                    (Destination,
                     Jpeglib.Internal.Markers.SOS,
                     [2,
                      16#41#, 16#00#,
                      16#42#, 16#00#,
                      1, 0, 0]),
                  "unknown arithmetic differential-lossless SOS two-component");
            elsif Components = 3 then
               Require
                 (Jpeglib.Internal.Writers.Write_Segment
                    (Destination,
                     Jpeglib.Internal.Markers.SOF15,
                     [8, 0, 1, 0, 1, 3,
                      16#41#, 16#11#, 0,
                      16#42#, 16#11#, 0,
                      16#43#, 16#11#, 0]),
                  "unknown arithmetic differential-lossless SOF15 three-component");
               Require
                 (Jpeglib.Internal.Writers.Write_Segment
                    (Destination,
                     Jpeglib.Internal.Markers.SOS,
                     [3,
                      16#41#, 16#00#,
                      16#42#, 16#00#,
                      16#43#, 16#00#,
                      1, 0, 0]),
                  "unknown arithmetic differential-lossless SOS three-component");
            else
               Require
                 (Jpeglib.Internal.Writers.Write_Segment
                    (Destination,
                     Jpeglib.Internal.Markers.SOF15,
                     [8, 0, 1, 0, 1, 4,
                      16#41#, 16#11#, 0,
                      16#42#, 16#11#, 0,
                      16#43#, 16#11#, 0,
                      16#44#, 16#11#, 0]),
                  "unknown arithmetic differential-lossless SOF15 four-component");
               Require
                 (Jpeglib.Internal.Writers.Write_Segment
                    (Destination,
                     Jpeglib.Internal.Markers.SOS,
                     [4,
                      16#41#, 16#00#,
                      16#42#, 16#00#,
                      16#43#, 16#00#,
                      16#44#, 16#00#,
                      1, 0, 0]),
                  "unknown arithmetic differential-lossless SOS four-component");
            end if;

            for Component in Jpeglib.Component_Index range 1 .. Jpeglib.Component_Index (Components) loop
               Outcome :=
                 Jpeglib.Internal.Arithmetic.Encode_DC_Difference
                   (Encoder,
                    Bins (Component),
                    Contexts (Component),
                    Conditioning => 16#5A#,
                    Difference => 0);
               Require
                 (Outcome,
                  "unknown arithmetic differential-lossless component"
                  & Jpeglib.Component_Index'Image (Component));
            end loop;
            Require
              (Jpeglib.Internal.Arithmetic.Finish (Encoder),
               "unknown arithmetic differential-lossless finish");
