      Raw_1_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 => 77];
      Raw_2_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 => 77];
      Raw_3_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 => 77];
