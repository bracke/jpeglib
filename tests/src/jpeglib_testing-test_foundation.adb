        (Descriptor =>
           (Width => 1,
            Height => 1,
            Format => Jpeglib.Images.Gray_8,
            Stride => 1,
            Accessible_Bytes => 1),
         Storage => Input_Storage'Unchecked_Access);
      Outcome : Jpeglib.Results.Result;
      Cursor : Positive := Output_Storage'First;
      Last : Positive;
   begin
      Jpeglib.Streams.Open (Destination, Output_Storage'Unchecked_Access);
      Outcome := Jpeglib.Internal.Baseline_Encoder.Encode_Gray_Image (Destination, Input);
      Assert (Jpeglib.Results.Succeeded (Outcome), "baseline gray JPEG encode failed");
      Assert (Jpeglib.Streams.Offset (Destination) > 0, "baseline gray JPEG wrote no bytes");

      Last := Output_Storage'First + Natural (Jpeglib.Streams.Offset (Destination)) - 1;
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.SOI);
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.APP0);
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.DQT);
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.DHT);
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.DHT);
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.SOF0);
      Assert_Next_Marker (Output_Storage, Cursor, Jpeglib.Internal.Markers.SOS);
