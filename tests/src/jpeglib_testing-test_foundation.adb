   procedure Baseline_Encoder_YCbCr_Roundtrips (T : in out AUnit.Test_Cases.Test_Case'Class) is
      pragma Unreferenced (T);

      function Marker_Count
        (Storage : Jpeglib.Streams.Byte_Array;
         Last : Positive;
         Marker : Jpeglib.Marker_Code) return Natural
      is
         Cursor : Positive := Storage'First;
         Length : Natural;
         Count : Natural := 0;
      begin
         while Cursor + 4 <= Last loop
            if Storage (Cursor) = 16#FF# and then Storage (Cursor + 1) = Jpeglib.Byte (Marker) then
               Count := Count + 1;
               if Jpeglib.Internal.Markers.Has_Length (Marker) then
                  Length := Natural (Storage (Cursor + 2)) * 256 + Natural (Storage (Cursor + 3));
                  Cursor := Cursor + 2 + Length;
               else
                  Cursor := Cursor + 2;
               end if;
            elsif Storage (Cursor) = 16#FF#
              and then Jpeglib.Internal.Markers.Has_Length (Jpeglib.Marker_Code (Storage (Cursor + 1)))
            then
               Length := Natural (Storage (Cursor + 2)) * 256 + Natural (Storage (Cursor + 3));
               Cursor := Cursor + 2 + Length;
            else
               Cursor := Cursor + 1;
            end if;
         end loop;

         return Count;
      end Marker_Count;

      Input_Storage : aliased Jpeglib.Streams.Byte_Array :=
        [255, 0, 0,
         255, 0, 0,
         255, 0, 0,
         255, 0, 0];
      Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
      Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 12 => 0];
      Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
      Source : aliased Jpeglib.Streams.Memory_Source;
      Decoder : Jpeglib.Decoding.Decoder;
      Input : constant Jpeglib.Images.Image_View :=
        (Descriptor =>
           (Width => 2,
            Height => 2,
            Format => Jpeglib.Images.RGB_24,
            Stride => 6,
            Accessible_Bytes => 12),
         Storage => Input_Storage'Unchecked_Access);
      Output : Jpeglib.Images.Mutable_Image_View :=
        (Descriptor =>
           (Width => 2,
            Height => 2,
            Format => Jpeglib.Images.RGB_24,
            Stride => 6,
            Accessible_Bytes => 12),
         Storage => Decoded_Storage'Unchecked_Access);
      Outcome : Jpeglib.Results.Result;
      Last : Positive;
      Difference : Natural;
   begin
      Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
      Outcome :=
        Jpeglib.Internal.Baseline_Encoder.Encode_YCbCr_Image
          (Destination,
           Input,
           Layout => Jpeglib.Internal.Image_Blocks.Subsampling_420,
           Quality => 100);
      Assert (Jpeglib.Results.Succeeded (Outcome), "baseline YCbCr encode failed");
      Assert (Jpeglib.Streams.Offset (Destination) > 0, "baseline YCbCr encoder wrote no bytes");

      Last := Encoded_Storage'First + Natural (Jpeglib.Streams.Offset (Destination)) - 1;
      Assert (Marker_Count (Encoded_Storage, Last, Jpeglib.Internal.Markers.DQT) = 2, "YCbCr DQT count mismatch");
      Assert (Marker_Count (Encoded_Storage, Last, Jpeglib.Internal.Markers.DHT) = 4, "YCbCr DHT count mismatch");
      Assert
        (Encoded_Storage (Last - 1) = 16#FF#
         and then Encoded_Storage (Last) = Jpeglib.Byte (Jpeglib.Internal.Markers.EOI),
         "baseline YCbCr JPEG missing EOI");

      Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
      Jpeglib.Decoding.Initialize
        (Decoder,
         Source'Access,
         (Output_Format => Jpeglib.Images.RGB_24, others => <>));
      Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
      Assert (Jpeglib.Results.Succeeded (Outcome), "baseline YCbCr roundtrip decode failed");

      for Index in Decoded_Storage'Range loop
         if Natural (Decoded_Storage (Index)) > Natural (Input_Storage (Index)) then
            Difference := Natural (Decoded_Storage (Index)) - Natural (Input_Storage (Index));
         else
            Difference := Natural (Input_Storage (Index)) - Natural (Decoded_Storage (Index));
         end if;

         Assert (Difference <= 3, "baseline YCbCr roundtrip drift too large");
      end loop;
   end Baseline_Encoder_YCbCr_Roundtrips;

