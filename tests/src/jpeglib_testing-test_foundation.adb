         Three_Component_Storage : aliased constant Jpeglib.Streams.Byte_Array := Generate (3);
         Four_Component_Storage : aliased constant Jpeglib.Streams.Byte_Array := Generate (4);
         Two_Component_Storage : aliased constant Jpeglib.Streams.Byte_Array := Generate (2);
         Source : aliased Jpeglib.Streams.Memory_Source;
         Decoder : Jpeglib.Decoding.Decoder;
         Outcome : Jpeglib.Results.Result;
         Info : Jpeglib.Decoding.Image_Info;
         RGB_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 3 => 0];
         RGBA_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4 => 0];
         RGB_Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 1,
               Height => 1,
               Format => Jpeglib.Images.RGB_24,
               Stride => 3,
               Accessible_Bytes => 3),
            Storage => RGB_Storage'Unchecked_Access);
         RGBA_Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 1,
               Height => 1,
               Format => Jpeglib.Images.RGBA_32,
               Stride => 4,
               Accessible_Bytes => 4),
            Storage => RGBA_Storage'Unchecked_Access);
      begin
         Decode_Unknown_Two_Component_Format_Matrix
           (Two_Component_Storage'Unchecked_Access,
            Jpeglib.Arithmetic,
            "unknown-color two-component arithmetic differential-lossless");

         Jpeglib.Streams.Open (Source, Three_Component_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize (Decoder, Source'Access);
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, RGB_Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            "unknown-color arithmetic differential-lossless three-component image decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code)
            & " source=" & Jpeglib.Source_Offset'Image (Outcome.First_Error.Context.Source)
            & " marker=" & Jpeglib.Marker_Code'Image (Outcome.First_Error.Context.Marker));
         Info := Jpeglib.Decoding.Header (Decoder);
         Assert
           (Info.Color_Model = Jpeglib.Unknown,
            "unknown-color arithmetic differential-lossless three-component model mismatch");
         Assert
           (Info.Mode = Jpeglib.Differential_Lossless,
            "unknown-color arithmetic differential-lossless three-component mode mismatch");
         Assert
           (Info.Entropy = Jpeglib.Arithmetic,
            "unknown-color arithmetic differential-lossless three-component entropy mismatch");
         Assert
           (RGB_Storage = [128, 128, 128],
            "unknown-color arithmetic differential-lossless three-component RGB mismatch");

         Jpeglib.Streams.Open (Source, Four_Component_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Jpeglib.Images.RGBA_32, Alpha_Fill => 17, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, RGBA_Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
