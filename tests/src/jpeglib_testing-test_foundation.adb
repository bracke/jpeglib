         Assert (Jpeglib.Decoding.State (Raw_Decoder) = Jpeglib.Decoding.Completed,
                 Label & " raw decoder state mismatch");
         Assert (Jpeglib.Decoding.Header (Raw_Decoder).Mode = Expected_Mode, Label & " raw mode mismatch");
         for Row in Natural range 0 .. 7 loop
            for Column in Natural range 0 .. Width - 1 loop
               Assert
                 (Raw_Storage (Raw_Storage'First + Row * 16 + Column) = Expected_Sample (Column, Row),
                  Label & " raw sample mismatch");
            end loop;
         end loop;

         Raw_Storage := [others => 77];
         Jpeglib.Streams.Open (Raw_Header_Source, Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize (Raw_Header_Decoder, Raw_Header_Source'Access);
         Outcome := Jpeglib.Decoding.Read_Header (Raw_Header_Decoder);
         Assert (Jpeglib.Results.Succeeded (Outcome), Label & " raw post-header read failed");
         Outcome := Jpeglib.Decoding.Decode_Raw_Components (Raw_Header_Decoder, Raw);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
