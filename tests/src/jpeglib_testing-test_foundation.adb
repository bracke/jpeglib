         end if;

         Jpeglib.Streams.Open (Raw_Source, Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize (Raw_Decoder, Raw_Source'Access);
         Outcome := Jpeglib.Decoding.Decode_Raw_Components (Raw_Decoder, Raw);
