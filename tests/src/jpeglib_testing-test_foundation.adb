      Decoder : Jpeglib.Decoding.Decoder;
      Restarted_Decoder : Jpeglib.Decoding.Decoder;
      Input : constant Jpeglib.Images.Image_View :=
        (Descriptor =>
           (Width => 4,
            Height => 2,
            Format => Jpeglib.Images.Gray_8,
            Stride => 4,
            Accessible_Bytes => 8),
         Storage => Input_Storage'Unchecked_Access);
      Output : Jpeglib.Images.Mutable_Image_View :=
        (Descriptor =>
           (Width => 4,
            Height => 2,
            Format => Jpeglib.Images.Gray_8,
            Stride => 4,
            Accessible_Bytes => 8),
         Storage => Decoded_Storage'Unchecked_Access);
      Restarted_Output : Jpeglib.Images.Mutable_Image_View :=
        (Descriptor =>
           (Width => 4,
            Height => 2,
            Format => Jpeglib.Images.Gray_8,
            Stride => 4,
            Accessible_Bytes => 8),
         Storage => Restarted_Decoded_Storage'Unchecked_Access);
      Outcome : Jpeglib.Results.Result;
