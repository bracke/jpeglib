            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert (Jpeglib.Decoding.State (Raw_Header_Decoder) = Jpeglib.Decoding.Completed,
                 Label & " post-header raw decoder state mismatch");
         Assert (Jpeglib.Decoding.Header (Raw_Header_Decoder).Mode = Expected_Mode,
                 Label & " post-header raw mode mismatch");
         for Row in Natural range 0 .. 7 loop
            for Column in Natural range 0 .. Width - 1 loop
               Assert
                 (Raw_Storage (Raw_Storage'First + Row * 16 + Column) = Expected_Sample (Column, Row),
                  Label & " post-header raw sample mismatch");
