            "arithmetic nonzero hierarchical SOF11");
         Require
           (Jpeglib.Internal.Writers.Write_SOS_Lossless_Grayscale (Destination),
            "arithmetic nonzero hierarchical base SOS");
         Write_Arithmetic_Difference (0, "arithmetic nonzero hierarchical base");

         Require
           (Jpeglib.Internal.Writers.Write_Segment
              (Destination,
               Jpeglib.Internal.Markers.SOF15,
               [8, 0, 1, 0, 1, 1, 1, 16#11#, 0]),
            "arithmetic nonzero hierarchical SOF15");
         Require
           (Jpeglib.Internal.Writers.Write_SOS_Lossless_Grayscale (Destination),
            "arithmetic nonzero hierarchical continuation SOS");
         Write_Arithmetic_Difference (1, "arithmetic nonzero hierarchical continuation");

         Require
           (Jpeglib.Internal.Writers.Write_Marker (Destination, Jpeglib.Internal.Markers.EOI),
            "arithmetic nonzero hierarchical EOI");
         Assert
           (Jpeglib.Streams.Offset (Destination) > 0,
            "arithmetic nonzero hierarchical generator wrote no bytes");

         return Storage;
      end Generate_Arithmetic_Nonzero_Storage;

      function Generate_Arithmetic_Two_Component_Nonzero_Storage return Generated_Hierarchical_Storage is
         Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 256 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Outcome : Jpeglib.Results.Result;

         type DC_Bin_Set_Array is array (Jpeglib.Component_Index range 1 .. 2) of
           Jpeglib.Internal.Arithmetic.Probability_Bin_Array (0 .. 63);
         type Context_Array is array (Jpeglib.Component_Index range 1 .. 2) of
           Jpeglib.Internal.Arithmetic.DC_Context_Index;
         type Difference_Array is array (Jpeglib.Component_Index range 1 .. 2) of
           Jpeglib.Internal.Arithmetic.DC_Difference;

         procedure Require (Result : Jpeglib.Results.Result; Label : String) is
         begin
            Assert
              (Jpeglib.Results.Succeeded (Result),
               Label & " failed: " & Jpeglib.Errors.Error_Code'Image (Result.First_Error.Code));
         end Require;

         procedure Write_Arithmetic_Differences
           (Differences : Difference_Array;
            Label : String)
         is
            Encoder : Jpeglib.Internal.Arithmetic.Encoder (Destination'Access);
            Bins : DC_Bin_Set_Array :=
              [others => [others => Jpeglib.Internal.Arithmetic.Initial_Probability_Bin]];
            Contexts : Context_Array := [others => 0];
         begin
            for Component in Jpeglib.Component_Index range 1 .. 2 loop
               Outcome :=
                 Jpeglib.Internal.Arithmetic.Encode_DC_Difference
                   (Encoder,
                    Bins (Component),
                    Contexts (Component),
                    Conditioning => 16#5A#,
                    Difference => Differences (Component));
               Require
                 (Outcome,
                  Label & " component" & Jpeglib.Component_Index'Image (Component)
                  & " arithmetic difference encode");
            end loop;

            Outcome := Jpeglib.Internal.Arithmetic.Finish (Encoder);
            Require (Outcome, Label & " arithmetic finish");
         end Write_Arithmetic_Differences;
      begin
