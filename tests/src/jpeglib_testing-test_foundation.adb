         Expected_Bytes := Jpeglib.Images.Minimum_Row_Bytes (8, Format) * 8;
         case Format is
            when Jpeglib.Images.Gray_8 =>
               Input :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8),
                     Accessible_Bytes => 8 * 8),
                  Storage => Gray_Storage'Unchecked_Access);
               Output :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8),
                     Accessible_Bytes => Expected_Bytes),
                  Storage => Decoded_Storage'Unchecked_Access);
            when Jpeglib.Images.Gray_Alpha_16 =>
               Input :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 2),
                     Accessible_Bytes => 8 * 8 * 2),
                  Storage => Gray_Alpha_Storage'Unchecked_Access);
               Output :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 2),
                     Accessible_Bytes => Expected_Bytes),
                  Storage => Decoded_Storage'Unchecked_Access);
            when Jpeglib.Images.RGB_24 | Jpeglib.Images.BGR_24 =>
               Input :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 3),
                     Accessible_Bytes => 8 * 8 * 3),
                  Storage => RGB_Storage'Unchecked_Access);
               Output :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 3),
                     Accessible_Bytes => Expected_Bytes),
                  Storage => Decoded_Storage'Unchecked_Access);
            when Jpeglib.Images.RGBA_32 | Jpeglib.Images.BGRA_32 =>
               Input :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 4),
                     Accessible_Bytes => 8 * 8 * 4),
                  Storage => RGBA_Storage'Unchecked_Access);
               Output :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 4),
                     Accessible_Bytes => Expected_Bytes),
                  Storage => Decoded_Storage'Unchecked_Access);
            when Jpeglib.Images.CMYK_32 =>
               Input :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 4),
                     Accessible_Bytes => 8 * 8 * 4),
                  Storage => CMYK_Storage'Unchecked_Access);
               Output :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 4),
                     Accessible_Bytes => Expected_Bytes),
                  Storage => Decoded_Storage'Unchecked_Access);
            when Jpeglib.Images.YCCK_32 =>
               Input :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 4),
                     Accessible_Bytes => 8 * 8 * 4),
                  Storage => YCCK_Storage'Unchecked_Access);
               Output :=
                 (Descriptor =>
                    (Width => 8,
                     Height => 8,
                     Format => Format,
                     Stride => Jpeglib.Row_Stride (8 * 4),
                     Accessible_Bytes => Expected_Bytes),
                  Storage => Decoded_Storage'Unchecked_Access);
         end case;

         Decoded_Storage := [others => 0];
         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Quality => 100,
             Mode => Mode,
             Progressive => Script,
             Subsampling => Subsampling,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            "V1 encode matrix failed for "
            & Label
            & ": "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            "V1 encode matrix state mismatch for " & Label);
         Assert (Jpeglib.Streams.Offset (Destination) > 0, "V1 encode matrix wrote no bytes for " & Label);

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, Alpha_Fill => 255, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            "V1 encode matrix decode failed for "
            & Label
            & ": "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            "V1 encode matrix decoder state mismatch for " & Label);
         Assert_Output_Matches;
      end Encode_Case;

   begin
      for Mode of Modes loop
         for Format of Formats loop
            if Is_Lossless_Mode (Mode) then
               for Script of Lossless_Scripts loop
                  Encode_Case (Mode, Script, Format);
               end loop;
            elsif Format in Jpeglib.Images.CMYK_32 | Jpeglib.Images.YCCK_32 then
               for Script of DCT_Scripts loop
                  for Subsampling of DCT_Subsamplings loop
                     Encode_Case (Mode, Script, Format, Subsampling);
                  end loop;
               end loop;
            else
               for Script of DCT_Scripts loop
                  Encode_Case (Mode, Script, Format);
               end loop;
            end if;
         end loop;
      end loop;
