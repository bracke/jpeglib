        [Jpeglib.Encoding.Subsampling_444,
         Jpeglib.Encoding.Subsampling_422,
         Jpeglib.Encoding.Subsampling_420,
         Jpeglib.Encoding.Subsampling_411];
      Formats : constant Format_List :=
        [Jpeglib.Images.Gray_8,
         Jpeglib.Images.Gray_Alpha_16,
         Jpeglib.Images.RGB_24,
         Jpeglib.Images.BGR_24,
         Jpeglib.Images.RGBA_32,
         Jpeglib.Images.BGRA_32,
         Jpeglib.Images.CMYK_32,
         Jpeglib.Images.YCCK_32];

      function Is_Lossless_Mode (Mode : Jpeglib.Encoding.Encoding_Mode) return Boolean is
        (Mode in
           Jpeglib.Encoding.Lossless_Huffman
           | Jpeglib.Encoding.Arithmetic_Lossless
           | Jpeglib.Encoding.Differential_Lossless_Huffman
           | Jpeglib.Encoding.Arithmetic_Differential_Lossless
           | Jpeglib.Encoding.Hierarchical_Lossless_Huffman
           | Jpeglib.Encoding.Hierarchical_Arithmetic_Lossless
           | Jpeglib.Encoding.Hierarchical_Differential_Lossless_Huffman
           | Jpeglib.Encoding.Hierarchical_Arithmetic_Differential_Lossless);

      procedure Encode_Case
        (Mode : Jpeglib.Encoding.Encoding_Mode;
         Script : Jpeglib.Encoding.Progressive_Script;
         Format : Jpeglib.Images.Pixel_Format;
         Subsampling : Jpeglib.Encoding.Chroma_Subsampling := Jpeglib.Encoding.Subsampling_444)
      is
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 16_384 => 0];
         Gray_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 => 128];
         Gray_Alpha_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 2 => 128];
         RGB_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 3 => 128];
         RGBA_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 4 => 128];
         CMYK_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 4 => 128];
         YCCK_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 4 => 128];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 4 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : Jpeglib.Images.Image_View;
         Output : Jpeglib.Images.Mutable_Image_View;
         Outcome : Jpeglib.Results.Result;
         Expected_Bytes : Jpeglib.Byte_Count;
         Difference : Natural;
         Label : constant String :=
           Jpeglib.Encoding.Encoding_Mode'Image (Mode)
           & " "
           & Jpeglib.Encoding.Progressive_Script'Image (Script)
           & " "
           & Jpeglib.Images.Pixel_Format'Image (Format)
           & " "
           & Jpeglib.Encoding.Chroma_Subsampling'Image (Subsampling);
         Allowed_Drift : constant Natural := (if Is_Lossless_Mode (Mode) then 0 else 16);

         procedure Initialize_Input_Patterns is
         begin
            for Row in Natural range 0 .. 7 loop
               for Column in Natural range 0 .. 7 loop
                  declare
                     Pixel : constant Natural := Row * 8 + Column;
                     Gray_Base : constant Positive := Gray_Storage'First + Pixel;
                     Gray_Alpha_Base : constant Positive := Gray_Alpha_Storage'First + Pixel * 2;
                     RGB_Base : constant Positive := RGB_Storage'First + Pixel * 3;
                     RGBA_Base : constant Positive := RGBA_Storage'First + Pixel * 4;
                     CMYK_Base : constant Positive := CMYK_Storage'First + Pixel * 4;
                     YCCK_Base : constant Positive := YCCK_Storage'First + Pixel * 4;
                  begin
                     Gray_Storage (Gray_Base) := Jpeglib.Byte (126 + ((Row + Column) mod 5));
                     Gray_Alpha_Storage (Gray_Alpha_Base) := Jpeglib.Byte (126 + ((Row + Column) mod 5));
                     Gray_Alpha_Storage (Gray_Alpha_Base + 1) := Jpeglib.Byte (126 + ((Row * 2 + Column) mod 5));

                     RGB_Storage (RGB_Base) := Jpeglib.Byte (126 + ((Row + Column) mod 5));
                     RGB_Storage (RGB_Base + 1) := Jpeglib.Byte (126 + ((Row * 2 + Column) mod 5));
                     RGB_Storage (RGB_Base + 2) := Jpeglib.Byte (126 + ((Row + Column * 2) mod 5));

                     RGBA_Storage (RGBA_Base) := Jpeglib.Byte (126 + ((Row + Column) mod 5));
                     RGBA_Storage (RGBA_Base + 1) := Jpeglib.Byte (126 + ((Row * 2 + Column) mod 5));
                     RGBA_Storage (RGBA_Base + 2) := Jpeglib.Byte (126 + ((Row + Column * 2) mod 5));
                     RGBA_Storage (RGBA_Base + 3) := Jpeglib.Byte (126 + ((Row * 3 + Column) mod 5));

                     CMYK_Storage (CMYK_Base) := Jpeglib.Byte (126 + ((Row + Column) mod 5));
                     CMYK_Storage (CMYK_Base + 1) := Jpeglib.Byte (126 + ((Row * 2 + Column) mod 5));
                     CMYK_Storage (CMYK_Base + 2) := Jpeglib.Byte (126 + ((Row + Column * 2) mod 5));
                     CMYK_Storage (CMYK_Base + 3) := Jpeglib.Byte (126 + ((Row * 3 + Column) mod 5));

                     YCCK_Storage (YCCK_Base) := Jpeglib.Byte (126 + ((Row + Column) mod 5));
                     YCCK_Storage (YCCK_Base + 1) := Jpeglib.Byte (126 + ((Row * 2 + Column) mod 5));
                     YCCK_Storage (YCCK_Base + 2) := Jpeglib.Byte (126 + ((Row + Column * 2) mod 5));
                     YCCK_Storage (YCCK_Base + 3) := Jpeglib.Byte (126 + ((Row * 3 + Column) mod 5));
                  end;
               end loop;
            end loop;
         end Initialize_Input_Patterns;

         function Expected_Source_Sample (Pixel : Natural; Offset : Natural) return Jpeglib.Byte is
         begin
            case Format is
               when Jpeglib.Images.Gray_8 =>
                  return Gray_Storage (Gray_Storage'First + Pixel);
               when Jpeglib.Images.Gray_Alpha_16 =>
                  return Gray_Alpha_Storage (Gray_Alpha_Storage'First + Pixel * 2 + Offset);
               when Jpeglib.Images.RGB_24 | Jpeglib.Images.BGR_24 =>
                  return RGB_Storage (RGB_Storage'First + Pixel * 3 + Offset);
               when Jpeglib.Images.RGBA_32 | Jpeglib.Images.BGRA_32 =>
                  return RGBA_Storage (RGBA_Storage'First + Pixel * 4 + Offset);
               when Jpeglib.Images.CMYK_32 =>
                  return CMYK_Storage (CMYK_Storage'First + Pixel * 4 + Offset);
               when Jpeglib.Images.YCCK_32 =>
                  return YCCK_Storage (YCCK_Storage'First + Pixel * 4 + Offset);
            end case;
         end Expected_Source_Sample;

         procedure Assert_Output_Matches is
         begin
            for Row in Natural range 0 .. 7 loop
               for Column in Natural range 0 .. 7 loop
                  declare
                     Pixel : constant Natural := Row * 8 + Column;
                     Base : constant Positive :=
                       Decoded_Storage'First
                       + Pixel * Natural (Jpeglib.Images.Bytes_Per_Pixel (Format));
                     Sample : Jpeglib.Byte;
                     Expected : Jpeglib.Byte;
                  begin
                     case Format is
                        when Jpeglib.Images.Gray_8 =>
                           Sample := Decoded_Storage (Base);
                           Expected := Expected_Source_Sample (Pixel, 0);
                           if Natural (Sample) > Natural (Expected) then
                              Difference := Natural (Sample) - Natural (Expected);
                           else
                              Difference := Natural (Expected) - Natural (Sample);
                           end if;
                           Assert (Difference <= Allowed_Drift, "V1 encode matrix grayscale drift for " & Label);
                        when Jpeglib.Images.Gray_Alpha_16 =>
                           for Offset in Natural range 0 .. 1 loop
                              Sample := Decoded_Storage (Base + Offset);
                              Expected := Expected_Source_Sample (Pixel, Offset);
                              if Natural (Sample) > Natural (Expected) then
                                 Difference := Natural (Sample) - Natural (Expected);
                              else
                                 Difference := Natural (Expected) - Natural (Sample);
                              end if;
                              Assert
                                (Difference <= Allowed_Drift,
                                 "V1 encode matrix gray-alpha drift for "
                                 & Label
                                 & " pixel="
                                 & Natural'Image (Pixel)
                                 & " offset="
                                 & Natural'Image (Offset)
                                 & " sample="
                                 & Jpeglib.Byte'Image (Sample)
                                 & " expected="
                                 & Jpeglib.Byte'Image (Expected));
                           end loop;
                        when Jpeglib.Images.RGB_24 | Jpeglib.Images.BGR_24 =>
                           for Offset in Natural range 0 .. 2 loop
                              Sample := Decoded_Storage (Base + Offset);
                              Expected := Expected_Source_Sample (Pixel, Offset);
                              if Natural (Sample) > Natural (Expected) then
                                 Difference := Natural (Sample) - Natural (Expected);
                              else
                                 Difference := Natural (Expected) - Natural (Sample);
                              end if;
                              Assert
                                (Difference <= Allowed_Drift,
                                 "V1 encode matrix RGB-family drift for "
                                 & Label
                                 & " pixel="
                                 & Natural'Image (Pixel)
                                 & " offset="
                                 & Natural'Image (Offset)
                                 & " sample="
                                 & Jpeglib.Byte'Image (Sample)
                                 & " expected="
                                 & Jpeglib.Byte'Image (Expected));
                           end loop;
                        when Jpeglib.Images.RGBA_32 | Jpeglib.Images.BGRA_32 =>
                           for Offset in Natural range 0 .. 2 loop
                              Sample := Decoded_Storage (Base + Offset);
                              Expected := Expected_Source_Sample (Pixel, Offset);
                              if Natural (Sample) > Natural (Expected) then
                                 Difference := Natural (Sample) - Natural (Expected);
                              else
                                 Difference := Natural (Expected) - Natural (Sample);
                              end if;
                              Assert
                                (Difference <= Allowed_Drift,
                                 "V1 encode matrix RGB-alpha color drift for "
                                 & Label
                                 & " pixel="
                                 & Natural'Image (Pixel)
                                 & " offset="
                                 & Natural'Image (Offset)
                                 & " sample="
                                 & Jpeglib.Byte'Image (Sample)
                                 & " expected="
                                 & Jpeglib.Byte'Image (Expected));
                           end loop;
                           Assert
                             (Decoded_Storage (Base + 3) = 255,
                              "V1 encode matrix alpha fill mismatch for " & Label);
                        when Jpeglib.Images.CMYK_32 | Jpeglib.Images.YCCK_32 =>
                           for Offset in Natural range 0 .. 3 loop
                              Sample := Decoded_Storage (Base + Offset);
                              Expected := Expected_Source_Sample (Pixel, Offset);
                              if Natural (Sample) > Natural (Expected) then
                                 Difference := Natural (Sample) - Natural (Expected);
                              else
                                 Difference := Natural (Expected) - Natural (Sample);
                              end if;
                              Assert
                                (Difference <= Allowed_Drift,
                                 "V1 encode matrix four-channel drift for "
                                 & Label
                                 & " sample="
                                 & Jpeglib.Byte'Image (Sample)
                                 & " expected="
                                 & Jpeglib.Byte'Image (Expected));
