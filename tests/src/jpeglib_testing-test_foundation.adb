         Outcome := Jpeglib.Decoding.Read_Header (Header_Decoder);
         Assert (Jpeglib.Results.Succeeded (Outcome), Label & " header failed");
         Header := Jpeglib.Decoding.Header (Header_Decoder);
         Assert (Header.Mode = Expected_Mode, Label & " header mode mismatch");

         Jpeglib.Streams.Open (Source, Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize (Decoder, Source'Access);
         Outcome := Jpeglib.Decoding.Decode_Coefficients (Decoder, Blocks, Blocks_Decoded);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " coefficient decode failed: " & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
                 Label & " coefficient decoder state mismatch");
         Assert (Jpeglib.Decoding.Header (Decoder).Mode = Expected_Mode, Label & " coefficient mode mismatch");
         Assert (Blocks_Decoded = Expected_Blocks, Label & " coefficient block count mismatch");
         if not Arithmetic and then not Progressive then
            Assert (Blocks (1) (0) = 2, Label & " first coefficient DC mismatch");
            Assert (Blocks (2) (0) = 4, Label & " second coefficient DC mismatch");
         elsif Progressive and then not Arithmetic then
            Assert (Blocks (1) (0) = 2, Label & " progressive coefficient DC mismatch");
            Assert (Blocks (1) (16) = 2, Label & " progressive coefficient AC mismatch");
         elsif Arithmetic and then not Progressive then
            Assert (Blocks (1) (0) = 0, Label & " arithmetic coefficient DC mismatch");
            Assert (Blocks (1) (1) = 1, Label & " arithmetic coefficient AC mismatch");
