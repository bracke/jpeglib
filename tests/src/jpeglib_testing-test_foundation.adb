      procedure Roundtrips_Point_Transform
        (Mode : Jpeglib.Encoding.Encoding_Mode;
         Format : Jpeglib.Images.Pixel_Format;
         Expected_Color : Jpeglib.Encoded_Color_Model;
         Point_Transform : Jpeglib.Lossless_Point_Transform_Value;
         Label : String)
      is
         Pixel_Bytes : constant Natural := Natural (Jpeglib.Images.Bytes_Per_Pixel (Format));
         Used_Bytes : constant Natural := 2 * Pixel_Bytes;
         Input_Storage : aliased Jpeglib.Streams.Byte_Array :=
           [0, 64, 128, 255, 240, 192, 96, 32];
         Expected_Storage : Jpeglib.Streams.Byte_Array := [1 .. 8 => 0];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 1,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Used_Bytes),
               Accessible_Bytes => Jpeglib.Byte_Count (Used_Bytes)),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 1,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Used_Bytes),
               Accessible_Bytes => Jpeglib.Byte_Count (Used_Bytes)),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Header : Jpeglib.Decoding.Image_Info;
         Last : Positive;
         Case_Name : constant String :=
           Jpeglib.Encoding.Encoding_Mode'Image (Mode)
           & " "
           & Label
           & " point transform"
           & Integer'Image (Natural (Point_Transform));

         function Transformed (Value : Jpeglib.Byte) return Jpeglib.Byte is
           (Jpeglib.Byte (Natural (Value) / (2 ** Natural (Point_Transform))));
      begin
         case Format is
            when Jpeglib.Images.Gray_8 | Jpeglib.Images.Gray_Alpha_16
               | Jpeglib.Images.CMYK_32 | Jpeglib.Images.YCCK_32 =>
               for Index in 1 .. Used_Bytes loop
                  Expected_Storage (Index) := Transformed (Input_Storage (Index));
               end loop;
            when Jpeglib.Images.RGB_24 | Jpeglib.Images.BGR_24 =>
               for Index in 1 .. Used_Bytes loop
                  Expected_Storage (Index) := Transformed (Input_Storage (Index));
               end loop;
            when Jpeglib.Images.RGBA_32 | Jpeglib.Images.BGRA_32 =>
               for Pixel in Natural range 0 .. 1 loop
                  Expected_Storage (Expected_Storage'First + Pixel * 4) :=
                    Transformed (Input_Storage (Input_Storage'First + Pixel * 4));
                  Expected_Storage (Expected_Storage'First + Pixel * 4 + 1) :=
                    Transformed (Input_Storage (Input_Storage'First + Pixel * 4 + 1));
                  Expected_Storage (Expected_Storage'First + Pixel * 4 + 2) :=
                    Transformed (Input_Storage (Input_Storage'First + Pixel * 4 + 2));
                  Expected_Storage (Expected_Storage'First + Pixel * 4 + 3) := 255;
               end loop;
         end case;

         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Mode,
             Lossless_Point_Transform => Point_Transform,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Case_Name & " hierarchical lossless encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Last := Positive (Jpeglib.Streams.Offset (Destination));
         Assert_Continuation_Frame (Encoded_Storage, Last, Mode, Case_Name);

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Case_Name & " hierarchical lossless decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Header := Jpeglib.Decoding.Header (Decoder);
         Assert (Header.Hierarchical, Case_Name & " hierarchical flag mismatch");
         Assert (Header.Mode = Expected_Mode (Mode), Case_Name & " mode mismatch");
         Assert (Header.Entropy = Expected_Entropy (Mode), Case_Name & " entropy mismatch");
         Assert (Header.Color_Model = Expected_Color, Case_Name & " color model mismatch");
         Assert
           (Header.Lossless_Point_Transform = Point_Transform,
            Case_Name & " point transform mismatch");
         Assert
           (Decoded_Storage (1 .. Used_Bytes) = Expected_Storage (1 .. Used_Bytes),
            Case_Name & " pixel mismatch");
      end Roundtrips_Point_Transform;
   begin
      for Mode of Modes loop
         Roundtrips_Gray (Mode);
         Roundtrips_Restarted_Gray (Mode);
         Roundtrips_Gray_Alpha (Mode);
         Roundtrips_RGB (Mode);
         Roundtrips_RGB_Family (Mode, Jpeglib.Images.BGR_24, "BGR");
         Roundtrips_RGB_Family (Mode, Jpeglib.Images.RGBA_32, "RGBA");
         Roundtrips_RGB_Family (Mode, Jpeglib.Images.BGRA_32, "BGRA");
         Roundtrips_Four_Component (Mode, Jpeglib.Images.CMYK_32, Jpeglib.CMYK, "CMYK");
         Roundtrips_Four_Component (Mode, Jpeglib.Images.YCCK_32, Jpeglib.YCCK, "YCCK");
         for Point_Transform in Jpeglib.Lossless_Point_Transform_Value loop
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.Gray_8,
               Jpeglib.Grayscale,
               Point_Transform,
               "grayscale");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.Gray_Alpha_16,
               Jpeglib.Unknown,
               Point_Transform,
               "gray-alpha");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.RGB_24,
               Jpeglib.RGB,
               Point_Transform,
               "RGB");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.BGR_24,
               Jpeglib.RGB,
               Point_Transform,
               "BGR");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.RGBA_32,
               Jpeglib.RGB,
               Point_Transform,
               "RGBA");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.BGRA_32,
               Jpeglib.RGB,
