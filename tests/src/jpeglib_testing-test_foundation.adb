      Assert (Jpeglib.Internal.Progressive.Coefficient_Seen (State, 1, 5), "last AC coefficient not marked seen");
      Assert
        (not Jpeglib.Internal.Progressive.Coefficient_Seen (State, 1, 6),
         "outside AC range was marked seen");

