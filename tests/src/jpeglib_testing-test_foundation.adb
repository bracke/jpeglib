   procedure Public_Encoder_Encodes_Lossless_Grayscale_Image (T : in out AUnit.Test_Cases.Test_Case'Class) is
      pragma Unreferenced (T);
      use type Jpeglib.Decoding.Decoder_State;
      Input_Storage : aliased Jpeglib.Streams.Byte_Array :=
        [127, 140, 92, 221,
         18, 252, 76, 199];
      Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 768 => 0];
      Restarted_Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 768 => 0];
      Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 => 0];
      Restarted_Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 => 0];
      Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
      Restarted_Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
