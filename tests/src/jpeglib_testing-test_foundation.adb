      procedure Decode_Unknown_Arithmetic_Differential_Lossless is
         subtype Generated_Storage is Jpeglib.Streams.Byte_Array (1 .. 512);

         function Generate (Components : Jpeglib.Component_Count) return Generated_Storage is
            Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 512 => 0];
            Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
            Encoder : Jpeglib.Internal.Arithmetic.Encoder (Destination'Access);
            type DC_Bin_Set_Array is array (Jpeglib.Component_Index range <>) of
              Jpeglib.Internal.Arithmetic.Probability_Bin_Array (0 .. 63);
            type Context_Array is array (Jpeglib.Component_Index range <>) of
              Jpeglib.Internal.Arithmetic.DC_Context_Index;
            Bins : DC_Bin_Set_Array (1 .. Jpeglib.Component_Index (Components)) :=
              [others => [others => Jpeglib.Internal.Arithmetic.Initial_Probability_Bin]];
            Contexts : Context_Array (1 .. Jpeglib.Component_Index (Components)) := [others => 0];
            Outcome : Jpeglib.Results.Result;

            procedure Require (Result : Jpeglib.Results.Result; Label : String) is
            begin
               Assert
                 (Jpeglib.Results.Succeeded (Result),
                  Label & " failed: " & Jpeglib.Errors.Error_Code'Image (Result.First_Error.Code));
            end Require;
