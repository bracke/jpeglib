           (Width => 8,
            Height => 8,
            Stride => 8,
            Accessible_Bytes => 8 * 8,
            Storage => Raw_2_Storage'Unchecked_Access),
         3 =>
           (Width => 8,
            Height => 8,
            Stride => 8,
            Accessible_Bytes => 8 * 8,
            Storage => Raw_3_Storage'Unchecked_Access)];
      Image_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 * 8 * 3 => 77];
