           (Outcome.First_Error.Context.Marker = Marker,
            Label & " raw decode marker context mismatch");
         Assert
           (Jpeglib.Decoding.State (Raw_Decoder) = Jpeglib.Decoding.Failed,
            Label & " raw decoder state mismatch");

         Jpeglib.Streams.Open (Image_Source, Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Image_Decoder,
            Image_Source'Access,
            (Output_Format => Jpeglib.Images.Gray_8, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Image_Decoder, Image);
         Assert (not Jpeglib.Results.Succeeded (Outcome), Label & " image decode succeeded");
         Assert
           (Outcome.First_Error.Code = Jpeglib.Errors.Unsupported_Feature,
            Label & " image decode used wrong error");
         Assert
           (Outcome.First_Error.Context.Marker = Marker,
            Label & " image decode marker context mismatch");
         Assert
           (Jpeglib.Decoding.State (Image_Decoder) = Jpeglib.Decoding.Failed,
            Label & " image decoder state mismatch");
