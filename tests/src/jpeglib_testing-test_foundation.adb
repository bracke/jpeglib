      procedure Roundtrips_Point_Transform
        (Mode : Jpeglib.Encoding.Encoding_Mode;
         Format : Jpeglib.Images.Pixel_Format;
         Expected_Color : Jpeglib.Encoded_Color_Model;
         Point_Transform : Jpeglib.Lossless_Point_Transform_Value;
         Label : String)
      is
         Pixel_Bytes : constant Natural := Natural (Jpeglib.Images.Bytes_Per_Pixel (Format));
         Used_Bytes : constant Natural := 2 * Pixel_Bytes;
         Input_Storage : aliased Jpeglib.Streams.Byte_Array :=
           [0, 64, 128, 255, 240, 192, 96, 32];
         Expected_Storage : Jpeglib.Streams.Byte_Array := [1 .. 8 => 0];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 2048 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 8 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 1,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Used_Bytes),
               Accessible_Bytes => Jpeglib.Byte_Count (Used_Bytes)),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 2,
               Height => 1,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Used_Bytes),
               Accessible_Bytes => Jpeglib.Byte_Count (Used_Bytes)),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Header : Jpeglib.Decoding.Image_Info;
         Expected_Entropy : constant Jpeglib.Entropy_Mode :=
           (if Mode = Jpeglib.Encoding.Differential_Lossless_Huffman then Jpeglib.Huffman else Jpeglib.Arithmetic);
         Case_Name : constant String :=
           Jpeglib.Encoding.Encoding_Mode'Image (Mode)
           & " "
           & Label
           & " point transform"
           & Integer'Image (Natural (Point_Transform));
      begin
         for Index in 1 .. Used_Bytes loop
            Expected_Storage (Index) :=
              Jpeglib.Byte (Natural (Input_Storage (Index)) / (2 ** Natural (Point_Transform)));
         end loop;

         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Mode,
             Lossless_Point_Transform => Point_Transform,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Case_Name & " differential lossless encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Case_Name & " differential lossless decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Header := Jpeglib.Decoding.Header (Decoder);
         Assert (Header.Mode = Jpeglib.Differential_Lossless, Case_Name & " mode mismatch");
         Assert (Header.Entropy = Expected_Entropy, Case_Name & " entropy mismatch");
         Assert (Header.Color_Model = Expected_Color, Case_Name & " color model mismatch");
         Assert
           (Header.Lossless_Point_Transform = Point_Transform,
            Case_Name & " point transform mismatch");
         Assert
           (Decoded_Storage (1 .. Used_Bytes) = Expected_Storage (1 .. Used_Bytes),
            Case_Name & " pixel mismatch");
      end Roundtrips_Point_Transform;
   begin
      for Mode in Jpeglib.Encoding.Differential_Lossless_Huffman ..
        Jpeglib.Encoding.Arithmetic_Differential_Lossless
      loop
         Roundtrips_Gray (Mode);
         Roundtrips_Gray_Alpha (Mode);
         Roundtrips_RGB (Mode);
         Roundtrips_Gray (Mode, Restart => 2, Case_Label => " restarted");
         Roundtrips_Gray_Alpha (Mode, Restart => 1, Case_Label => " restarted");
         Roundtrips_RGB (Mode, Restart => 1, Case_Label => " restarted");
         Roundtrips_RGB_Family (Mode, Jpeglib.Images.BGR_24, "BGR", Restart => 1);
         Roundtrips_RGB_Family (Mode, Jpeglib.Images.RGBA_32, "RGBA");
         Roundtrips_RGB_Family (Mode, Jpeglib.Images.BGRA_32, "BGRA");
         Roundtrips_Four_Component (Mode, Jpeglib.Images.CMYK_32, Jpeglib.CMYK, "CMYK");
         Roundtrips_Four_Component (Mode, Jpeglib.Images.YCCK_32, Jpeglib.YCCK, "YCCK");
         for Point_Transform in Jpeglib.Lossless_Point_Transform_Value loop
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.Gray_8,
               Jpeglib.Grayscale,
               Point_Transform,
               "grayscale");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.Gray_Alpha_16,
               Jpeglib.Unknown,
               Point_Transform,
               "gray-alpha");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.RGB_24,
               Jpeglib.RGB,
               Point_Transform,
               "RGB");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.CMYK_32,
               Jpeglib.CMYK,
               Point_Transform,
               "CMYK");
            Roundtrips_Point_Transform
              (Mode,
               Jpeglib.Images.YCCK_32,
               Jpeglib.YCCK,
               Point_Transform,
               "YCCK");
         end loop;
      end loop;
   end Public_Encoder_Encodes_Differential_Lossless_Images;

   procedure Public_Encoder_Encodes_Hierarchical_Lossless_Images
     (T : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T);
      use type Jpeglib.Decoding.Decoder_State;

      type Hierarchical_Mode_List is array (Positive range <>) of Jpeglib.Encoding.Encoding_Mode;
      Modes : constant Hierarchical_Mode_List :=
        [Jpeglib.Encoding.Hierarchical_Lossless_Huffman,
         Jpeglib.Encoding.Hierarchical_Arithmetic_Lossless,
         Jpeglib.Encoding.Hierarchical_Differential_Lossless_Huffman,
         Jpeglib.Encoding.Hierarchical_Arithmetic_Differential_Lossless];

      function Expected_Entropy (Mode : Jpeglib.Encoding.Encoding_Mode) return Jpeglib.Entropy_Mode is
        (case Mode is
           when Jpeglib.Encoding.Hierarchical_Lossless_Huffman
              | Jpeglib.Encoding.Hierarchical_Differential_Lossless_Huffman =>
             Jpeglib.Huffman,
           when others =>
             Jpeglib.Arithmetic);

      function Expected_Mode (Mode : Jpeglib.Encoding.Encoding_Mode) return Jpeglib.Frame_Mode is
        (case Mode is
           when Jpeglib.Encoding.Hierarchical_Differential_Lossless_Huffman
              | Jpeglib.Encoding.Hierarchical_Arithmetic_Differential_Lossless =>
             Jpeglib.Differential_Lossless,
           when others =>
             Jpeglib.Lossless);

      function Marker_Count
        (Storage : Jpeglib.Streams.Byte_Array;
         Last : Positive;
         Marker : Jpeglib.Marker_Code) return Natural
      is
         Cursor : Positive := Storage'First;
         Length : Natural;
         Count : Natural := 0;
      begin
         while Cursor + 4 <= Last loop
            if Storage (Cursor) = 16#FF# and then Storage (Cursor + 1) = Jpeglib.Byte (Marker) then
               Count := Count + 1;
               if Jpeglib.Internal.Markers.Has_Length (Marker) then
                  Length := Natural (Storage (Cursor + 2)) * 256 + Natural (Storage (Cursor + 3));
                  Cursor := Cursor + 2 + Length;
               else
                  Cursor := Cursor + 2;
               end if;
            elsif Storage (Cursor) = 16#FF#
              and then Jpeglib.Internal.Markers.Has_Length (Jpeglib.Marker_Code (Storage (Cursor + 1)))
            then
               Length := Natural (Storage (Cursor + 2)) * 256 + Natural (Storage (Cursor + 3));
               Cursor := Cursor + 2 + Length;
            else
               Cursor := Cursor + 1;
            end if;
         end loop;

         return Count;
      end Marker_Count;

      function Restart_Marker_Count
        (Storage : Jpeglib.Streams.Byte_Array;
         Last : Positive) return Natural
      is
         Count : Natural := 0;
      begin
         for Marker in Jpeglib.Internal.Markers.RST0 .. Jpeglib.Internal.Markers.RST7 loop
            Count := Count + Marker_Count (Storage, Last, Marker);
         end loop;

         return Count;
      end Restart_Marker_Count;

      procedure Assert_Continuation_Frame
        (Storage : Jpeglib.Streams.Byte_Array;
         Last : Positive;
         Mode : Jpeglib.Encoding.Encoding_Mode;
         Label : String)
      is
      begin
         case Mode is
            when Jpeglib.Encoding.Hierarchical_Lossless_Huffman =>
               Assert
                 (Marker_Count (Storage, Last, Jpeglib.Internal.Markers.SOF7) = 1,
                  Label & " hierarchical Huffman continuation SOF7 count mismatch");
               Assert
                 (Marker_Count (Storage, Last, Jpeglib.Internal.Markers.SOF15) = 0,
                  Label & " hierarchical Huffman unexpected SOF15 continuation");
            when Jpeglib.Encoding.Hierarchical_Arithmetic_Lossless =>
               Assert
                 (Marker_Count (Storage, Last, Jpeglib.Internal.Markers.SOF15) = 1,
                  Label & " hierarchical arithmetic continuation SOF15 count mismatch");
               Assert
                 (Marker_Count (Storage, Last, Jpeglib.Internal.Markers.SOF7) = 0,
                  Label & " hierarchical arithmetic unexpected SOF7 continuation");
            when others =>
               null;
         end case;
      end Assert_Continuation_Frame;

      procedure Roundtrips_Gray (Mode : Jpeglib.Encoding.Encoding_Mode) is
         Input_Storage : aliased Jpeglib.Streams.Byte_Array := [127, 140, 92, 221];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 1024 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4 => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => 4,
               Height => 1,
               Format => Jpeglib.Images.Gray_8,
               Stride => 4,
               Accessible_Bytes => 4),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 4,
               Height => 1,
               Format => Jpeglib.Images.Gray_8,
               Stride => 4,
               Accessible_Bytes => 4),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Header : Jpeglib.Decoding.Image_Info;
