   begin
      Jpeglib.Streams.Open (Header_Source, Storage'Unchecked_Access);
      Jpeglib.Decoding.Initialize (Header_Decoder, Header_Source'Access);
      Outcome := Jpeglib.Decoding.Read_Header (Header_Decoder);
      Assert
        (Jpeglib.Results.Succeeded (Outcome),
         "hierarchical arithmetic DCT continuation header read failed: "
         & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
      Header := Jpeglib.Decoding.Header (Header_Decoder);
      Assert (Header.Hierarchical, "hierarchical arithmetic DCT continuation header flag mismatch");
      Assert
        (Header.Mode = Jpeglib.Extended_Sequential_DCT,
         "hierarchical arithmetic DCT continuation base mode mismatch");
      Assert
        (Header.Color_Model = Jpeglib.YCbCr,
         "hierarchical arithmetic DCT continuation color model mismatch");

      Jpeglib.Streams.Open (Source, Storage'Unchecked_Access);
      Jpeglib.Decoding.Initialize (Decoder, Source'Access);
      Outcome := Jpeglib.Decoding.Decode_Coefficients (Decoder, Blocks, Blocks_Decoded);
      Assert
        (Jpeglib.Results.Succeeded (Outcome),
         "hierarchical arithmetic DCT continuation coefficient decode failed: "
         & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
      Assert
        (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
         "hierarchical arithmetic DCT continuation coefficient decoder state mismatch");
      Header := Jpeglib.Decoding.Header (Decoder);
      Assert
        (Header.Hierarchical,
         "hierarchical arithmetic DCT continuation coefficient header flag mismatch");
      Assert
        (Header.Mode = Jpeglib.Extended_Sequential_DCT,
         "hierarchical arithmetic DCT continuation reported wrong base mode");
      Assert (Blocks_Decoded = 3, "hierarchical arithmetic DCT continuation coefficient count mismatch");
      for Block_Index in Blocks'Range loop
         Assert
           (Blocks (Block_Index) (0) = 4,
            "hierarchical arithmetic DCT continuation DC composition mismatch");
         for Index in Jpeglib.Coefficient_Index range 1 .. 63 loop
            Assert
              (Blocks (Block_Index) (Index) = 0,
               "hierarchical arithmetic DCT continuation AC coefficient mismatch");
         end loop;
      end loop;

      Jpeglib.Streams.Open (Raw_Source, Storage'Unchecked_Access);
      Jpeglib.Decoding.Initialize (Raw_Decoder, Raw_Source'Access);
      Outcome := Jpeglib.Decoding.Decode_Raw_Components (Raw_Decoder, Raw);
      Assert
        (Jpeglib.Results.Succeeded (Outcome),
         "hierarchical arithmetic DCT continuation raw decode failed: "
         & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code)
         & " source=" & Jpeglib.Source_Offset'Image (Outcome.First_Error.Context.Source)
         & " marker=" & Jpeglib.Marker_Code'Image (Outcome.First_Error.Context.Marker)
         & " detail=" & Long_Long_Integer'Image (Outcome.First_Error.Context.Detail));
      Assert
        (Jpeglib.Decoding.Header (Raw_Decoder).Hierarchical,
         "hierarchical arithmetic DCT continuation raw header flag mismatch");
      for Sample of Raw_1_Storage loop
         Assert (Sample = 128, "hierarchical arithmetic DCT continuation raw component 1 sample mismatch");
      end loop;
      for Sample of Raw_2_Storage loop
         Assert (Sample = 128, "hierarchical arithmetic DCT continuation raw component 2 sample mismatch");
      end loop;
      for Sample of Raw_3_Storage loop
         Assert (Sample = 128, "hierarchical arithmetic DCT continuation raw component 3 sample mismatch");
      end loop;

      Jpeglib.Streams.Open (Image_Source, Storage'Unchecked_Access);
      Jpeglib.Decoding.Initialize
        (Image_Decoder,
         Image_Source'Access,
         (Output_Format => Jpeglib.Images.RGB_24, others => <>));
      Outcome := Jpeglib.Decoding.Decode_Image (Image_Decoder, Image);
      Assert
        (Jpeglib.Results.Succeeded (Outcome),
         "hierarchical arithmetic DCT continuation image decode failed: "
         & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
      Assert
        (Jpeglib.Decoding.Header (Image_Decoder).Hierarchical,
         "hierarchical arithmetic DCT continuation image header flag mismatch");
      for Sample of Image_Storage loop
         Assert (Sample = 128, "hierarchical arithmetic DCT continuation image sample mismatch");
      end loop;
   end Public_Decoder_Decodes_Multi_Frame_Hierarchical_Arithmetic_DCT_Coefficients;

