         Info := Jpeglib.Decoding.Header (Decoder);
         Assert
           (Info.Color_Model = Jpeglib.Unknown,
            "unknown-color arithmetic differential-lossless four-component model mismatch");
         Assert
           (Info.Mode = Jpeglib.Differential_Lossless,
            "unknown-color arithmetic differential-lossless four-component mode mismatch");
         Assert
           (Info.Entropy = Jpeglib.Arithmetic,
