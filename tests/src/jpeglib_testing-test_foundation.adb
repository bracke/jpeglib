   procedure Public_Encoder_Encodes_Hierarchical_DCT_Images
     (T : in out AUnit.Test_Cases.Test_Case'Class)
   is
      pragma Unreferenced (T);
      use type Jpeglib.Decoding.Decoder_State;
      use type Jpeglib.Encoding.Encoding_Mode;
      use type Jpeglib.Encoding.Progressive_Script;
      Expected_AC_Block : constant Jpeglib.Internal.Transforms.Sample_Block :=
        Jpeglib.Internal.Transforms.Reconstruct_Block ([0 => 0, 1 => 1, others => 0]);

      type Hierarchical_Mode_List is array (Positive range <>) of Jpeglib.Encoding.Encoding_Mode;
      Modes : constant Hierarchical_Mode_List :=
        [Jpeglib.Encoding.Hierarchical_Sequential_DCT,
         Jpeglib.Encoding.Hierarchical_Arithmetic_Sequential_DCT,
         Jpeglib.Encoding.Hierarchical_Differential_Sequential_DCT,
         Jpeglib.Encoding.Hierarchical_Arithmetic_Differential_Sequential_DCT];

      function Is_Arithmetic_Mode (Mode : Jpeglib.Encoding.Encoding_Mode) return Boolean is
        (Mode in
           Jpeglib.Encoding.Hierarchical_Arithmetic_Sequential_DCT
           | Jpeglib.Encoding.Hierarchical_Arithmetic_Differential_Sequential_DCT);

      function Is_Differential_Mode (Mode : Jpeglib.Encoding.Encoding_Mode) return Boolean is
        (Mode in
           Jpeglib.Encoding.Hierarchical_Differential_Sequential_DCT
           | Jpeglib.Encoding.Hierarchical_Arithmetic_Differential_Sequential_DCT);

      function Expected_Color_Model
        (Format : Jpeglib.Images.Pixel_Format) return Jpeglib.Encoded_Color_Model
      is
        (case Format is
           when Jpeglib.Images.Gray_8 =>
             Jpeglib.Grayscale,
           when Jpeglib.Images.Gray_Alpha_16 =>
             Jpeglib.Unknown,
           when Jpeglib.Images.CMYK_32 =>
             Jpeglib.CMYK,
           when Jpeglib.Images.YCCK_32 =>
             Jpeglib.YCCK,
           when others =>
             Jpeglib.YCbCr);

      procedure Roundtrips
        (Mode : Jpeglib.Encoding.Encoding_Mode;
         Progressive : Jpeglib.Encoding.Progressive_Script;
         Format : Jpeglib.Images.Pixel_Format;
         Label : String;
         Restart : Jpeglib.Restart_Interval := 0;
         Width : Jpeglib.Image_Width := 8;
         Subsampling : Jpeglib.Encoding.Chroma_Subsampling := Jpeglib.Encoding.Subsampling_444;
         Pattern_Channel : Natural := 4)
      is
         Bytes_Per_Pixel : constant Natural := Natural (Jpeglib.Images.Bytes_Per_Pixel (Format));
         Storage_Length : constant Positive := Positive (Natural (Width) * 8 * Bytes_Per_Pixel);
         Input_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. Storage_Length => 128];
         Encoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 4096 => 0];
         Decoded_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. Storage_Length => 0];
         Destination : aliased Jpeglib.Streams.Fixed_Buffer_Destination;
         Source : aliased Jpeglib.Streams.Memory_Source;
         Encoder : Jpeglib.Encoding.Encoder;
         Decoder : Jpeglib.Decoding.Decoder;
         Input : constant Jpeglib.Images.Image_View :=
           (Descriptor =>
              (Width => Width,
               Height => 8,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Natural (Width) * Bytes_Per_Pixel),
               Accessible_Bytes => Jpeglib.Byte_Count (Storage_Length)),
            Storage => Input_Storage'Unchecked_Access);
         Output : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => Width,
               Height => 8,
               Format => Format,
               Stride => Jpeglib.Row_Stride (Natural (Width) * Bytes_Per_Pixel),
               Accessible_Bytes => Jpeglib.Byte_Count (Storage_Length)),
            Storage => Decoded_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
         Header : Jpeglib.Decoding.Image_Info;
         Expected_Entropy : constant Jpeglib.Entropy_Mode :=
           (if Is_Arithmetic_Mode (Mode) then Jpeglib.Arithmetic else Jpeglib.Huffman);
         Expected_Mode : constant Jpeglib.Frame_Mode :=
           (if Is_Differential_Mode (Mode) then
              (if Progressive = Jpeglib.Encoding.No_Progressive then
                  Jpeglib.Differential_Sequential_DCT
               else
                  Jpeglib.Differential_Progressive_DCT)
            elsif Progressive = Jpeglib.Encoding.No_Progressive then
              (if Is_Arithmetic_Mode (Mode) then
                  Jpeglib.Extended_Sequential_DCT
               else
                  Jpeglib.Baseline_DCT)
            else
              Jpeglib.Progressive_DCT);
         Expected_Color : constant Jpeglib.Encoded_Color_Model :=
           Expected_Color_Model (Format);
         Case_Label : constant String := Jpeglib.Encoding.Encoding_Mode'Image (Mode) & " " & Label;

         function Marker_Count (Marker : Jpeglib.Marker_Code) return Natural is
            Last : constant Natural :=
              Encoded_Storage'First + Natural (Jpeglib.Streams.Offset (Destination)) - 1;
            Count : Natural := 0;
         begin
            if Last <= Encoded_Storage'First then
               return 0;
            end if;

            for Index in Encoded_Storage'First .. Last - 1 loop
               if Encoded_Storage (Index) = 16#FF#
                 and then Encoded_Storage (Index + 1) = Jpeglib.Byte (Marker)
               then
                  Count := Count + 1;
               end if;
            end loop;

            return Count;
         end Marker_Count;
      begin
         if Pattern_Channel < Bytes_Per_Pixel then
            for Index in Jpeglib.Coefficient_Index range 0 .. 63 loop
               Input_Storage
                 (Input_Storage'First
                  + Natural (Index) * Bytes_Per_Pixel
                  + Pattern_Channel) :=
                    Expected_AC_Block (Index);
            end loop;
         end if;

         Jpeglib.Streams.Open (Destination, Encoded_Storage'Unchecked_Access);
         Jpeglib.Encoding.Initialize
           (Encoder,
            Destination'Access,
            (Mode => Mode,
             Progressive => Progressive,
             Quality => 100,
             Restart => Restart,
             Subsampling => Subsampling,
             others => <>));
         Outcome := Jpeglib.Encoding.Encode_Image (Encoder, Input);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Case_Label & " hierarchical DCT encode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Encoding.State (Encoder) = Jpeglib.Encoding.Completed,
            Case_Label & " hierarchical DCT encoder state mismatch");
         if Mode = Jpeglib.Encoding.Hierarchical_Sequential_DCT
           and then Progressive = Jpeglib.Encoding.No_Progressive
         then
            Assert
              (Marker_Count (Jpeglib.Internal.Markers.SOF5) = 1,
               Case_Label & " hierarchical DCT zero-residual SOF5 continuation missing");
         elsif Mode = Jpeglib.Encoding.Hierarchical_Arithmetic_Sequential_DCT
           and then Progressive = Jpeglib.Encoding.No_Progressive
         then
            Assert
              (Marker_Count (Jpeglib.Internal.Markers.SOF13) = 1,
               Case_Label & " hierarchical arithmetic DCT zero-residual SOF13 continuation missing");
         end if;

         Jpeglib.Streams.Open (Source, Encoded_Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize
           (Decoder,
            Source'Access,
            (Output_Format => Format, others => <>));
         Outcome := Jpeglib.Decoding.Decode_Image (Decoder, Output);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Case_Label & " hierarchical DCT decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert
           (Jpeglib.Decoding.State (Decoder) = Jpeglib.Decoding.Completed,
            Case_Label & " hierarchical DCT decoder state mismatch");

         Header := Jpeglib.Decoding.Header (Decoder);
         Assert (Header.Hierarchical, Case_Label & " hierarchical DCT flag mismatch");
         Assert
           (Header.Mode = Expected_Mode,
            Case_Label & " hierarchical DCT mode mismatch; expected "
            & Jpeglib.Frame_Mode'Image (Expected_Mode)
            & " got "
            & Jpeglib.Frame_Mode'Image (Header.Mode));
         Assert (Header.Progressive = (Progressive /= Jpeglib.Encoding.No_Progressive),
                 Case_Label & " hierarchical DCT progressive flag mismatch");
         Assert (Header.Entropy = Expected_Entropy, Case_Label & " hierarchical DCT entropy mismatch");
         Assert (Header.Color_Model = Expected_Color, Case_Label & " hierarchical DCT color model mismatch");
         Assert (Header.Restart = Restart, Case_Label & " hierarchical DCT restart mismatch");
         Assert (Decoded_Storage = Input_Storage, Case_Label & " hierarchical DCT pixel mismatch");
      end Roundtrips;
   begin
      for Mode of Modes loop
         Roundtrips (Mode, Jpeglib.Encoding.No_Progressive, Jpeglib.Images.Gray_8, "grayscale sequential");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.Gray_Alpha_16,
            "gray-alpha sequential");
         Roundtrips (Mode, Jpeglib.Encoding.No_Progressive, Jpeglib.Images.RGB_24, "RGB sequential");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB sequential 4:2:2",
            Subsampling => Jpeglib.Encoding.Subsampling_422,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB sequential 4:2:0",
            Subsampling => Jpeglib.Encoding.Subsampling_420,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB sequential 4:1:1",
            Subsampling => Jpeglib.Encoding.Subsampling_411,
            Width => 16);
         Roundtrips (Mode, Jpeglib.Encoding.Balanced_Progressive, Jpeglib.Images.Gray_8, "grayscale progressive");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.Gray_Alpha_16,
            "gray-alpha balanced progressive");
         Roundtrips (Mode, Jpeglib.Encoding.Balanced_Progressive, Jpeglib.Images.RGB_24, "RGB progressive");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB balanced progressive 4:2:2",
            Subsampling => Jpeglib.Encoding.Subsampling_422,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB balanced progressive 4:2:0",
            Subsampling => Jpeglib.Encoding.Subsampling_420,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB balanced progressive 4:1:1",
            Subsampling => Jpeglib.Encoding.Subsampling_411,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.Gray_8,
            "grayscale fast-preview progressive");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.Gray_Alpha_16,
            "gray-alpha fast-preview progressive");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB fast-preview progressive");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB fast-preview progressive 4:2:2",
            Subsampling => Jpeglib.Encoding.Subsampling_422,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB fast-preview progressive 4:2:0",
            Subsampling => Jpeglib.Encoding.Subsampling_420,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Fast_Preview_Progressive,
            Jpeglib.Images.RGB_24,
            "RGB fast-preview progressive 4:1:1",
            Subsampling => Jpeglib.Encoding.Subsampling_411,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.No_Progressive,
            Jpeglib.Images.Gray_8,
            "restarted grayscale sequential",
            Restart => 1,
            Width => 16);
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.RGB_24,
            "restarted RGB balanced progressive",
            Restart => 1,
            Width => 16);
         Roundtrips (Mode, Jpeglib.Encoding.No_Progressive, Jpeglib.Images.CMYK_32, "CMYK sequential");
         Roundtrips (Mode, Jpeglib.Encoding.No_Progressive, Jpeglib.Images.YCCK_32, "YCCK sequential");
         Roundtrips
           (Mode,
            Jpeglib.Encoding.Balanced_Progressive,
            Jpeglib.Images.CMYK_32,
            "CMYK balanced progressive");
         Roundtrips
           (Mode,
