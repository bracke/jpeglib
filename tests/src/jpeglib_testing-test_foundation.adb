               [16#00#, 16#5A#, 16#10#, 0]),
            "hierarchical arithmetic DCT DAC");
         Require
           (Jpeglib.Internal.Writers.Write_Segment
              (Destination,
               Jpeglib.Internal.Markers.SOF9,
               [8, 0, 8, 0, 8, 3,
                1, 16#11#, 0,
                2, 16#11#, 0,
                3, 16#11#, 0]),
            "hierarchical arithmetic DCT SOF9");
         Write_Three_Component_Scan ("hierarchical arithmetic DCT SOS");
         Write_Arithmetic_Blocks ("hierarchical arithmetic DCT base");
         Write_Three_Component_Frame
           (Jpeglib.Internal.Markers.SOF13,
            "hierarchical arithmetic differential DCT SOF13");
         Write_Three_Component_Scan ("hierarchical arithmetic differential DCT SOS");
         Write_Arithmetic_Blocks ("hierarchical arithmetic DCT residual");
         Require
           (Jpeglib.Internal.Writers.Write_Marker (Destination, Jpeglib.Internal.Markers.EOI),
