         Coefficient_Decoder : Jpeglib.Decoding.Decoder;
         Raw_Decoder : Jpeglib.Decoding.Decoder;
         Image_Decoder : Jpeglib.Decoding.Decoder;
         Blocks : Jpeglib.Coefficients.DCT_Block_Array (1 .. 1) := [others => [others => 0]];
         Blocks_Decoded : Jpeglib.Block_Count := 1;
         Raw_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 1 => 0];
         Raw : Jpeglib.Decoding.Raw_Component_View_Array (1 .. 1) :=
           [1 =>
              (Width => 1,
               Height => 1,
               Stride => 1,
               Accessible_Bytes => 1,
               Storage => Raw_Storage'Unchecked_Access)];
         Image_Storage : aliased Jpeglib.Streams.Byte_Array := [1 .. 1 => 0];
         Image : Jpeglib.Images.Mutable_Image_View :=
           (Descriptor =>
              (Width => 1,
               Height => 1,
               Format => Jpeglib.Images.Gray_8,
               Stride => 1,
               Accessible_Bytes => 1),
            Storage => Image_Storage'Unchecked_Access);
         Outcome : Jpeglib.Results.Result;
      begin
         Jpeglib.Streams.Open (Header_Source, Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize (Header_Decoder, Header_Source'Access);
         Outcome := Jpeglib.Decoding.Read_Header (Header_Decoder);
         Assert (not Jpeglib.Results.Succeeded (Outcome), Label & " header read succeeded");
         Assert
           (Outcome.First_Error.Code = Jpeglib.Errors.Unsupported_Feature,
            Label & " header read used wrong error");
         Assert
           (Outcome.First_Error.Context.Marker = Marker,
            Label & " header read marker context mismatch");

         Jpeglib.Streams.Open (Coefficient_Source, Storage'Unchecked_Access);
         Jpeglib.Decoding.Initialize (Coefficient_Decoder, Coefficient_Source'Access);
         Outcome := Jpeglib.Decoding.Decode_Coefficients (Coefficient_Decoder, Blocks, Blocks_Decoded);
         Assert (not Jpeglib.Results.Succeeded (Outcome), Label & " coefficient decode succeeded");
         Assert
           (Outcome.First_Error.Code = Jpeglib.Errors.Unsupported_Feature,
            Label & " coefficient decode used wrong error");
