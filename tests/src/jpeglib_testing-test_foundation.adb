         Jpeglib.Decoding.Initialize
           (Image_Header_Decoder,
            Image_Header_Source'Access,
            (Output_Format => Jpeglib.Images.Gray_8, others => <>));
         Outcome := Jpeglib.Decoding.Read_Header (Image_Header_Decoder);
         Assert (Jpeglib.Results.Succeeded (Outcome), Label & " image post-header read failed");
         Outcome := Jpeglib.Decoding.Decode_Image (Image_Header_Decoder, Image);
         Assert
           (Jpeglib.Results.Succeeded (Outcome),
            Label & " post-header image decode failed: "
            & Jpeglib.Errors.Error_Code'Image (Outcome.First_Error.Code));
         Assert (Jpeglib.Decoding.State (Image_Header_Decoder) = Jpeglib.Decoding.Completed,
                 Label & " post-header image decoder state mismatch");
         Assert (Jpeglib.Decoding.Header (Image_Header_Decoder).Mode = Expected_Mode,
                 Label & " post-header image mode mismatch");
         for Row in Natural range 0 .. 7 loop
            for Column in Natural range 0 .. Width - 1 loop
               Assert
                 (Image_Storage (Image_Storage'First + Row * 16 + Column) = Expected_Sample (Column, Row),
                  Label & " post-header image sample mismatch");
            end loop;
         end loop;
      end Decodes_DCT;

