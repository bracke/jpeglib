         Assert (Storage (Cursor) = 16#FF#, "baseline encoder marker prefix mismatch");
         Assert (Storage (Cursor + 1) = Jpeglib.Byte (Marker), "baseline encoder marker code mismatch");
         Cursor := Cursor + 2;

         if Jpeglib.Internal.Markers.Has_Length (Marker) then
            Length := Natural (Storage (Cursor)) * 256 + Natural (Storage (Cursor + 1));
            Assert (Length >= 2, "baseline encoder segment length invalid");
            Cursor := Cursor + Length;
         end if;
