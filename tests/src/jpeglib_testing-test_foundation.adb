         function Expected_Sample (Column, Row : Natural) return Jpeglib.Byte is
            Index : constant Jpeglib.Coefficient_Index :=
              Jpeglib.Coefficient_Index (Row * 8 + Column mod 8);
         begin
            if Progressive and then not Arithmetic then
               return Expected_Huffman_Progressive (Index);
            elsif Arithmetic and then not Progressive then
               return Expected_Arithmetic_Sequential (Index);
